(version 4.2.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml menhir easy-format re yojson cmdliner)))

(source
 (fetch
  (url https://github.com/ahrefs/atd/releases/download/4.2.0/atd-4.2.0.tbz)
  (checksum
   sha512=337f2739167936de28e042bf2d05df8c535c0c8293fb86c086861c8cc8a617d0d6c0bafb09e4817c5ae6d77dff7d0afcaed3f235c6c9ae7104c784c17d286605)))
